# Copy to .env.local for local dev, or set in Vercel project settings.

# Base URL of the deployed FastAPI backend (no trailing slash).
# Local dev default (when unset) is http://localhost:8000.
NEXT_PUBLIC_API_URL="https://your-backend.hf.space"

# --- Supabase (auth + chat history) ---
# Project URL and PUBLIC anon key from: Supabase dashboard → Settings → API.
# The anon key is safe to expose in the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...your-anon-public-key..."

# --- Guest / demo account ---
# Pre-seeded read-only-ish demo account used by the /guest fast-access link.
# These are intentionally public (low-privilege demo account, RLS-scoped).
# Use a real, non-reserved domain — Supabase rejects example.com / .local etc.
NEXT_PUBLIC_DEMO_EMAIL="guest@nexusdata.app"
NEXT_PUBLIC_DEMO_PASSWORD="change-me-demo-password"
