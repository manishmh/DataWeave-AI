# ---------------------------------------------------------------------------
# backend/.env  — copy this file to backend/.env and fill in real values.
# This file (.env.example) is safe to commit; .env itself is gitignored.
# ---------------------------------------------------------------------------

# === Auth (Supabase) ========================================================
# When set, /query, /upload, /pdfs and /storage require a valid Supabase access
# token (Bearer). Set the one that matches your project's JWT signing:
#   SUPABASE_URL         → for ES256/RS256 asymmetric keys (current default) —
#                          tokens are verified against the project's JWKS.
#   SUPABASE_JWT_SECRET  → for legacy HS256 (Settings → API → JWT Secret).
# Setting SUPABASE_URL is recommended; it covers modern projects. If NEITHER is
# set, enforcement is disabled (routes open — a warning is logged on boot).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET=""

# === LLM (OpenRouter) =======================================================
# Your OpenRouter API key (https://openrouter.ai/keys). Required.
API_KEY="sk-or-v1-..."

# Primary model. Leave UNSET to use the built-in free-model fallback chain
# (recommended for free hosting). Set it to pin a specific model, e.g. a paid
# one if you have credits:
#   MODEL="openai/gpt-4o-mini"
# To force a particular free model first:
#   MODEL="meta-llama/llama-3.3-70b-instruct:free"
# MODEL=

# Extra fallback models tried after MODEL, comma-separated. Optional —
# the code already appends a built-in free list as a safety net.
# FALLBACK_MODELS="google/gemini-2.0-flash-exp:free,deepseek/deepseek-chat-v3-0324:free"

# === Vector DB (Qdrant) =====================================================
# Qdrant Cloud cluster endpoint, e.g.
#   https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxx.eu-central.aws.cloud.qdrant.io:6333
# Leave UNSET for local on-disk dev (data/qdrant_local), or set ":memory:"
# for an ephemeral in-process store (tests).
QDRANT_URL=""

# Qdrant Cloud API key (from the cluster's "API Keys" tab). Required for cloud.
QDRANT_API_KEY=""

# Collection name (optional; defaults to "pdf_chunks").
# QDRANT_COLLECTION="pdf_chunks"

# --- Memory guard (free tier = 1 GB RAM) ---
# After each upload, if estimated cluster memory crosses the high-water mark,
# the oldest PDFs are evicted (LRU) down to the low-water mark. The newest
# upload is never evicted. Estimated memory = BASELINE_MB + Qdrant's reported
# resident memory (read live from its /metrics endpoint).
# QDRANT_GUARD_ENABLED="true"      # set "false" to disable auto-eviction
# QDRANT_MEM_HIGH_MB="900"         # start evicting at/above this
# QDRANT_MEM_LOW_MB="700"          # evict down to this
# QDRANT_BASELINE_MB="110"         # constant pod overhead not in /metrics

# === ETL tuning (optional) ==================================================
# Thread pool size for camelot table extraction.
# ETL_TABLE_WORKERS=4
