# Root files
Nexus_Data_Project_Report.pdf
.DS_Store
.vscode/
.idea/
.codex

# HF Space deploy mirror — separate git repo, pushed to Hugging Face directly.
# The canonical backend lives in backend/; do not commit this duplicate.
hf-space/

# Secrets / credential dumps — never commit
*api_key*.txt
*secret*
*.pem

# Python bytecode (anywhere in the tree)
**/__pycache__/
*.py[cod]

# Frontend (Next.js / Node)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!frontend/.env.example
frontend/*.log

# Backend (Python)
backend/.env
backend/.env.*
backend/.env.local
# …but keep the committed template
!backend/.env.example

backend/__pycache__/
backend/*.py[cod]
backend/*.pyo
backend/*.pyd
backend/*.egg-info/
backend/dist/
backend/build/
backend/.eggs/
backend/*.egg
backend/*.whl
backend/.venv/
backend/venv/
backend/env/

backend/data/chroma_db/
backend/data/qdrant_local/
backend/data/chunks.json
backend/data/tables/
backend/data/*.pdf
backend/data/*.csv
backend/data/*.xlsx

# Local model / HF caches (downloaded at runtime, never committed)
backend/.cache/
backend/models/

backend/logs/

backend/.vscode/
backend/.idea/
backend/*.swp
backend/*.swo

hf-space